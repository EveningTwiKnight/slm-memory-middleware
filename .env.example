# ===== 中间件配置 =====
#
# 使用方法：
#   1. 把本文件复制为 .env
#        Windows:        copy .env.example .env
#        Mac / Linux:    cp .env.example .env
#   2. 把 LLM_API_KEY 换成你自己的 Key（下面第 20 行有获取方法）
#   3. 其他项保持默认即可
#
# ⚠️ .env 已被 .gitignore 忽略，不会被提交到 Git，可以放心填。

# ============================================================
# 模型服务（必填）
# ============================================================
# 本中间件对接任何「OpenAI 兼容」接口，所以阿里云、智谱、DeepSeek、
# 硅基流动、本地 Ollama 都能用，只需要改下面三行。

# --- 方案 A：阿里云百炼（推荐，有免费额度）---
#   获取 Key：https://bailian.console.aliyun.com/ → 右上角头像 → API-KEY
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# --- 方案 B：智谱 BigModel ---
#   获取 Key：https://open.bigmodel.cn/ → 右上角 → API-KEY
#   使用时把上面两行换成：
#     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#     LLM_MODEL=glm-4-flash

# --- 方案 C：本地 Ollama（完全免费、数据不出本机）---
#   先安装 https://ollama.com/ 然后执行：ollama pull qwen3:8b
#   使用时把上面两行换成：
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=qwen3:8b
#     LLM_API_KEY=ollama          ← 本地服务不校验 Key，随便填一个非空值即可

# ⬇⬇⬇ 把你的 Key 填在等号后面（不要加引号、不要留空格）⬇⬇⬇
LLM_API_KEY=

# ============================================================
# 服务参数（一般不用改）
# ============================================================
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 单次请求超时（秒）与失败重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 采样温度：0=稳定保守，1=发散有创意。助手类场景 0.7 比较合适
LLM_TEMPERATURE=0.7
# 输出上限。1024 会让较长的建议类回答被硬截断，所以给 2048
LLM_MAX_TOKENS=2048

# ============================================================
# 记忆系统（一般不用改）
# ============================================================
# 每轮注入几条记忆
MEMORY_TOP_K=5
# 注入时的重要度门槛
MEMORY_MIN_IMPORTANCE=0.3
# 检索时先召回多少条候选再精排
MEMORY_CANDIDATE_K=20
# 语义重复判定阈值。
# 实测：同一件事不同措辞约 0.82，完全无关约 0.54，所以在中间取 0.80。
# 早期凭感觉设 0.92，导致去重完全失效（够不到）。
SEMANTIC_DEDUPE_THRESHOLD=0.80
# 是否启用知识库检索（RAG）
ENABLE_KNOWLEDGE=true
# 知识库相关度门槛。不加门槛时无关问题也会注入整份文档，实测白烧 851 token。
# 实测：命中问题的资料 0.49~0.61，无关问题最高约 0.21。
KNOWLEDGE_MIN_SIMILARITY=0.45
# 最多注入几条资料
KNOWLEDGE_TOP_K=3
# 检索意图判断：问题是否"关于用户本人"。
# 开启后，问"今天天气怎么样"这类问题时不会去翻记忆库，省 token 也不干扰模型。
# 实测无关问题的 prompt 从 302 token 降到 99（省 67%）。
ENABLE_INTENT_GATE=true
# 提示词总预算（超出按优先级裁剪，人设与当前输入永不裁）
MAX_PROMPT_TOKENS=2400
# 是否启用预算调度 / 情感模块 / 记忆抽取（关掉可做消融对比）
ENABLE_BUDGET=true
ENABLE_EMOTION=true
ENABLE_EXTRACTION=true

# ============================================================
# 存储（一般不用改）
# ============================================================
DATABASE_PATH=data/app.db
CHROMA_PATH=chroma_data

# ============================================================
# 嵌入模型（首次运行会自动下载，约 100MB）
# ============================================================
# 本地嵌入模型。CPU 就能跑，不需要显卡。
EMBED_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像。国内直连 huggingface.co 通常不通，必须走镜像。
# 备选：https://hf-mirror.com  或  https://www.modelscope.cn
HF_ENDPOINT=https://hf-mirror.com
